# Shared dependency stage
FROM node:20-alpine AS dependencies

WORKDIR /app

# Native build dependencies for modules such as better-sqlite3. OpenSSL lets
# Prisma select the correct engine while generating its clients.
RUN apk add --no-cache python3 make g++ openssl

COPY backend/package*.json ./
RUN npm ci && npm cache clean --force

# Build stage
FROM dependencies AS builder

COPY backend/tsconfig.json ./

# Copy prisma schema
COPY backend/prisma ./prisma/

# Set default provider for build-time Prisma generation (runtime can override via DATABASE_PROVIDER)
RUN sed -i '/datasource db {/,/}/ s/provider = env("[^"]*")/provider = "sqlite"/; /datasource db {/,/}/ s/provider = "[^"]*"/provider = "sqlite"/' prisma/schema.prisma

# Generate both supported Prisma clients while the image is being built. Keeping
# provider-specific clients in the image prevents `prisma generate` from
# downloading engine binaries when a container starts in an egress-restricted
# environment. Restore the SQLite client for the TypeScript build below.
RUN set -eu; \
    mkdir -p /app/prisma_clients/sqlite /app/prisma_clients/postgresql; \
    npx prisma generate; \
    cp -R /app/src/generated/. /app/prisma_clients/sqlite/; \
    sed -i '/datasource db {/,/}/ s/provider = "[^"]*"/provider = "postgresql"/' prisma/schema.prisma; \
    npx prisma generate; \
    cp -R /app/src/generated/. /app/prisma_clients/postgresql/; \
    rm -rf /app/src/generated; \
    mkdir -p /app/src/generated; \
    cp -R /app/prisma_clients/sqlite/. /app/src/generated/; \
    sed -i '/datasource db {/,/}/ s/provider = "[^"]*"/provider = "sqlite"/' prisma/schema.prisma

# Copy source code
COPY backend/src ./src

# Build TypeScript
RUN npx tsc

# Remove development dependencies from the already-built dependency tree rather
# than compiling production dependencies a second time.
FROM dependencies AS production-dependencies

RUN npm prune --omit=dev && npm cache clean --force

# Production stage
FROM node:20-alpine

# Install runtime packages and create non-root user
RUN apk add --no-cache openssl su-exec && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

WORKDIR /app

COPY --chown=nodejs:nodejs --chmod=0444 backend/package.json ./
COPY --from=production-dependencies /app/node_modules ./node_modules

# Application version changes should not invalidate the dependency layer.
COPY --chown=nodejs:nodejs --chmod=0444 VERSION ./VERSION

# Copy prisma schema and migrations for runtime and hydration template
COPY backend/prisma ./prisma/
COPY --chown=nodejs:nodejs backend/prisma ./prisma_template/

# Copy built application from builder
COPY --from=builder /app/dist ./dist

# Copy the provider-specific Prisma clients generated by the builder. The
# entrypoint selects one without invoking Prisma's generator at runtime.
COPY --from=builder /app/prisma_clients ./prisma_clients

# Prepare runtime-writable paths before dropping privileges. Named volumes
# inherit this ownership on first use; bind mounts must be writable by UID 1001.
RUN mkdir -p /app/uploads /app/prisma /app/dist/generated && \
    chown nodejs:nodejs /app/dist && \
    chown -R nodejs:nodejs /app/uploads /app/prisma /app/dist/generated

# Do not inherit host filesystem modes for the executable entrypoint.
COPY --chown=nodejs:nodejs --chmod=0555 backend/docker-entrypoint.sh ./

USER nodejs

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.sh"]
